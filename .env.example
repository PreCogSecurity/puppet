# Environment variables honored by Puppet and its build tooling.
# Copy to `.env` and adjust as needed. Never commit real secrets in `.env`.

# --- Build time (Gemfile) ---------------------------------------------------
# RubyGems source mirror. Useful in air-gapped or proxied environments.
GEM_SOURCE=https://rubygems.org

# Override the gem source for facter/hiera (e.g. a git URL or file:// path).
# FACTER_LOCATION=git@github.com:puppetlabs/facter.git#master
# HIERA_LOCATION=git@github.com:puppetlabs/hiera.git#master

# --- Runtime (Puppet master/agent) ------------------------------------------
# Outbound HTTP proxy used by Puppet for module downloads and report
# forwarding (see lib/puppet/util/http_proxy.rb).
# http_proxy=http://proxy.example.com:3128
# HTTP_PROXY=http://proxy.example.com:3128
# no_proxy=localhost,127.0.0.1
# NO_PROXY=localhost,127.0.0.1

# Locale for subprocess execution (Puppet forces C locale for external
# commands; set these to override the container default).
# LANG=C.UTF-8
# LC_ALL=C.UTF-8

# --- Test time (spec suite) -------------------------------------------------
# Enable SimpleCov coverage measurement and enforce the minimum coverage gate.
# COVERAGE=yes
# MINIMUM_COVERAGE=40